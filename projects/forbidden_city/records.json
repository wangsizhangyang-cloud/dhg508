[
 {"id": 1, "building_id": 0, "year": 1406, "date": "1406", "fact": "明成祖朱棣下令营建北京宫殿（紫禁城），以南京故宫为蓝本，工程历时14年。", "people": "明成祖（朱棣）", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "首段", "note": ""},
 {"id": 2, "building_id": 0, "year": 1420, "date": "1420（永乐十八年）", "fact": "紫禁城落成，同年十二月完工；永乐帝于完工前正式宣布定都北京。", "people": "明成祖（朱棣）", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "首段／历史", "note": ""},
 {"id": 3, "building_id": 0, "year": 1421, "date": "1421（永乐十九年）正月初一", "fact": "明朝正式迁都北京，永乐帝在紫禁城举行庆祝活动。", "people": "明成祖（朱棣）", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "历史", "note": ""},
 {"id": 4, "building_id": 0, "year": 1421, "date": "1421（永乐十九年）五月", "fact": "紫禁城遭雷击发生大火，前三殿（奉天、华盖、谨身）被焚毁。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "历史", "note": ""},
 {"id": 5, "building_id": 0, "year": 1420, "date": "1420–1924", "fact": "自1420年至1924年，紫禁城为明清两代24位皇帝（明14位、清10位）的皇宫，是中国500余年的政治权力中心。", "people": "", "place": "北京", "source": "维基百科（英）《Forbidden City》", "source_url": "https://en.wikipedia.org/wiki/Forbidden_City", "source_locator": "首段／History", "note": ""},
 {"id": 6, "building_id": 0, "year": 1644, "date": "1644（崇祯十七年）", "fact": "李自成军攻陷北京、明朝灭亡；李自成向陕西撤退前焚毁紫禁城，仅武英殿、建极殿、英华殿、南薰殿、四周角楼和皇极门等未焚。", "people": "李自成", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "历史", "note": ""},
 {"id": 7, "building_id": 0, "year": 1925, "date": "1925年10月10日", "fact": "故宫博物院正式成立并向公众开放。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "历史", "note": ""},
 {"id": 8, "building_id": 0, "year": 1987, "date": "1987", "fact": "紫禁城被联合国教科文组织列入《世界文化遗产》名录。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "首段", "note": ""},
 {"id": 9, "building_id": 0, "year": 0, "date": "（无年代）", "fact": "紫禁城占地面积约72万平方米，南北长961米、东西宽753米，有大小宫殿七十多座、房屋九千余间，是世界上现存规模最大、最完整的宫殿型建筑。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "首段", "note": "英文条目称占地72公顷、现存建筑980座、8886间；中文条目称房屋九千余间"},
 {"id": 10, "building_id": 0, "year": 0, "date": "（无年代）", "fact": "紫禁城分「外朝」与「内廷」：外朝中心为三大殿（太和殿、中和殿、保和殿），内廷中心为后三宫（乾清宫、交泰殿、坤宁宫），其后为御花园。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "首段", "note": ""},
 {"id": 11, "building_id": 0, "year": 0, "date": "（无年代）", "fact": "城墙四面各有一座城门：南为午门，北为神武门，东为东华门，西为西华门；城墙四角各有一座角楼。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "首段", "note": "城墙高度与护城河宽度中、英文来源记载不一（中文：墙高10米、护城河59米；英文：墙高7.9米、护城河宽52米）"},

 {"id": 12, "building_id": 1, "year": 1420, "date": "1420（永乐十八年）", "fact": "午门建于明永乐十八年（1420年），清代顺治年间重建。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "主要建筑·午门", "note": ""},
 {"id": 13, "building_id": 1, "year": 0, "date": "（形制）", "fact": "午门平面呈倒「凹」字形，上部正楼面阔9间、进深5间、重檐庑殿顶，两翼各有重檐攒尖顶方亭；下部墩台正中开3门、两侧各1掖门。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "主要建筑·午门", "note": ""},
 {"id": 14, "building_id": 1, "year": 0, "date": "（制度）", "fact": "中门为皇帝出入专用；清代新科状元、榜眼、探花在发榜之日可从中门进出一次；皇帝大婚时皇后可乘轿从中门进入。其余官员走左门、宗室王公走右门。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "主要建筑·午门", "note": "英文条目亦记中门为皇帝专用，皇后大婚及殿试前三名例外"},
 {"id": 15, "building_id": 1, "year": 0, "date": "（功能）", "fact": "清代每年冬至在午门颁发次年年历；遇战争获胜，在此举行凯旋、「献俘」仪式。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "主要建筑·午门", "note": ""},
 {"id": 16, "building_id": 1, "year": 1561, "date": "1557–1561（嘉靖三十六年至四十年）", "fact": "嘉靖三十六年（1557年）紫禁城大火，前三殿、奉天门、文武楼、午门全部被焚毁，至1561年才重建完工。", "people": "", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "历史", "note": "原文「1557年（嘉靖三十六年）……至1561年才重建完工」"},
 {"id": 17, "building_id": 1, "year": 0, "date": "（形制）", "fact": "午门是紫禁城最大的门，其门楼建筑群因由五座建筑组成，又称「五凤楼」；两翼伸出部分源于古代阙楼。", "people": "", "place": "北京", "source": "维基百科（英）《Meridian Gate》", "source_url": "https://en.wikipedia.org/wiki/Meridian_Gate", "source_locator": "正文", "note": ""},

 {"id": 18, "building_id": 2, "year": 1420, "date": "1420（永乐十八年）", "fact": "太和门建成于明永乐十八年（1420年），初称「奉天门」。", "people": "", "place": "北京", "source": "维基百科（中文）《太和門》", "source_url": "https://zh.wikipedia.org/wiki/太和門", "source_locator": "首段", "note": ""},
 {"id": 19, "building_id": 2, "year": 1562, "date": "1562（嘉靖四十一年）", "fact": "太和门于嘉靖三十七年重建后改称「大朝门」，嘉靖四十一年（1562年）改称「皇极门」；清顺治二年（1645年）随太和殿改称「太和门」。", "people": "", "place": "北京", "source": "维基百科（中文）《太和門》", "source_url": "https://zh.wikipedia.org/wiki/太和門", "source_locator": "命名史", "note": ""},
 {"id": 20, "building_id": 2, "year": 1644, "date": "1644（顺治元年）九月", "fact": "清定鼎北京后，首位皇帝顺治帝在太和门颁布大赦令。", "people": "顺治帝", "place": "北京", "source": "维基百科（中文）《太和門》", "source_url": "https://zh.wikipedia.org/wiki/太和門", "source_locator": "明朝／清朝", "note": ""},
 {"id": 21, "building_id": 2, "year": 1889, "date": "1889年1月16日（光绪十四年十二月十五日）", "fact": "太和门西侧的贞度门护军值班房因护军熟睡、油灯点燃门柱引发大火，延烧太和门与昭德门，三门俱被焚毁；救火出动7000多人次，大火烧了两天。", "people": "", "place": "北京", "source": "维基百科（中文）《太和門》", "source_url": "https://zh.wikipedia.org/wiki/太和門", "source_locator": "清朝", "note": ""},
 {"id": 22, "building_id": 2, "year": 1889, "date": "1889年2月", "fact": "因光绪帝大婚在即（1889年2月26日）而仅剩42天，重建不及，清廷命北京棚匠搭成一座彩棚太和门，高广与真门相仿，几可乱真，供大婚使用。", "people": "光绪帝", "place": "北京", "source": "维基百科（中文）《太和門》", "source_url": "https://zh.wikipedia.org/wiki/太和門", "source_locator": "清朝", "note": ""},
 {"id": 23, "building_id": 2, "year": 1890, "date": "1889–1890（光绪十五年）", "fact": "光绪十五年重建太和门。", "people": "", "place": "北京", "source": "维基百科（中文）《太和門》", "source_url": "https://zh.wikipedia.org/wiki/太和門", "source_locator": "首段／清朝", "note": "英文条目记此次重建于1894年完成"},
 {"id": 24, "building_id": 2, "year": 0, "date": "（形制）", "fact": "太和门是紫禁城内最大的宫门，重檐歇山顶，下承须弥座式汉白玉基座，通高23.8米；建筑面积1371.14平方米。", "people": "", "place": "北京", "source": "维基百科（中文）《太和門》", "source_url": "https://zh.wikipedia.org/wiki/太和門", "source_locator": "首段／建筑", "note": "面阔记载有九间与七间两说（首段「面阔九间」，首段前文「东西阔七间」）"},
 {"id": 25, "building_id": 2, "year": 0, "date": "（功能）", "fact": "明代皇帝在太和门（时称奉天门）「御门听政」，接受臣下朝拜上奏、颁布诏令、处理政事；清初沿用，后御门听政改在乾清门。", "people": "", "place": "北京", "source": "维基百科（中文）《太和門》", "source_url": "https://zh.wikipedia.org/wiki/太和門", "source_locator": "明朝", "note": ""},
 {"id": 26, "building_id": 2, "year": 0, "date": "（形制）", "fact": "太和门前广场约26000平方米，内金水河蜿蜒流过，河上建五座汉白玉石桥（内金水桥），中间一座为皇帝通行的「御路桥」。", "people": "", "place": "北京", "source": "维基百科（中文）《太和門》", "source_url": "https://zh.wikipedia.org/wiki/太和門", "source_locator": "建筑", "note": ""},

 {"id": 27, "building_id": 3, "year": 1420, "date": "1406–1420（永乐四年至十八年）", "fact": "太和殿始建于永乐四年（1406年），建成于永乐十八年（1420年），初名「奉天殿」。", "people": "明成祖（朱棣）", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "历史", "note": ""},
 {"id": 28, "building_id": 3, "year": 1562, "date": "1562（嘉靖四十一年）", "fact": "嘉靖三十六年（1557年）奉天殿遭雷击焚毁，嘉靖四十一年（1562年）重建后改名「皇极殿」，体量缩至原奉天殿约三分之二。", "people": "", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "历史", "note": "初建奉天殿据《明世宗实录》面阔95米、进深48米、面积约4522平方米"},
 {"id": 29, "building_id": 3, "year": 1645, "date": "1645（顺治二年）", "fact": "清顺治二年改名为「太和殿」，顺治三年（1646年）与康熙八年（1669年）各重修一次。", "people": "顺治帝", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "历史", "note": ""},
 {"id": 30, "building_id": 3, "year": 1697, "date": "1695–1697（康熙三十四年至三十六年）", "fact": "康熙十八年（1679年）十二月初三夜，太和殿西边御膳房失火，太和殿再次被焚毁；康熙三十四年至三十六年（1695–1697年）重建，即现存形制。", "people": "康熙帝", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "历史", "note": ""},
 {"id": 31, "building_id": 3, "year": 0, "date": "（用途）", "fact": "明清两朝皇帝即位、大婚、册立皇后、命将出征等大典均在太和殿举行；每年万寿节、元旦、冬至三大节在此举行「大朝仪」。", "people": "", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "历史", "note": ""},
 {"id": 32, "building_id": 3, "year": 0, "date": "（形制）", "fact": "现存太和殿面阔11间（63.96米）、进深5间（37米），建筑面积2377平方米，通高35.05米；重檐庑殿顶，为中国现存最大的木结构建筑之一。", "people": "", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "建筑", "note": ""},
 {"id": 33, "building_id": 3, "year": 0, "date": "（形制）", "fact": "太和殿檐角有10个脊兽（龙、凤、狮子、天马、海马、狻猊、狎鱼、獬豸、斗牛、行什），数量之多为现存古建筑中所仅见。", "people": "", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "建筑", "note": ""},
 {"id": 34, "building_id": 3, "year": 0, "date": "（陈设）", "fact": "殿内设髹金漆云龙纹宝座（明嘉靖遗物）；宝座上方悬乾隆帝御题「建极绥猷」匾。", "people": "乾隆帝", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "殿内陈设", "note": ""},
 {"id": 35, "building_id": 3, "year": 0, "date": "（陈设）", "fact": "殿内天花板正中藻井雕蟠龙，龙口衔大铜珠「轩辕镜」；相传非受命于天者坐上宝座，轩辕镜会落下将其击死。", "people": "", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "殿内陈设", "note": ""},
 {"id": 36, "building_id": 3, "year": 0, "date": "（形制）", "fact": "太和殿共有立柱72根，其中宝座两侧6根为沥粉贴金云龙巨柱，直径约1米；殿内共铺苏州「金砖」4718块。", "people": "", "place": "北京", "source": "维基百科（中文）《太和殿》", "source_url": "https://zh.wikipedia.org/wiki/太和殿", "source_locator": "建筑", "note": ""},

 {"id": 37, "building_id": 4, "year": 1420, "date": "1420（永乐十八年）", "fact": "中和殿始建于永乐十八年（1420年），初称「华盖殿」。", "people": "", "place": "北京", "source": "维基百科（中文）《中和殿》", "source_url": "https://zh.wikipedia.org/wiki/中和殿", "source_locator": "历史", "note": ""},
 {"id": 38, "building_id": 4, "year": 1645, "date": "1645（顺治二年）", "fact": "嘉靖年间火灾后重建改称「中极殿」，清顺治二年（1645年）始改称「中和殿」，名取自《礼记·中庸》。", "people": "", "place": "北京", "source": "维基百科（中文）《中和殿》", "source_url": "https://zh.wikipedia.org/wiki/中和殿", "source_locator": "历史", "note": ""},
 {"id": 39, "building_id": 4, "year": 0, "date": "（形制）", "fact": "中和殿平面呈正方形，面阔、进深各三间，单檐四角攒尖顶，铜胎鎏金宝顶，建筑面积580平方米，是三大殿中最小者，高29米。", "people": "", "place": "北京", "source": "维基百科（中文）《中和殿》", "source_url": "https://zh.wikipedia.org/wiki/中和殿", "source_locator": "建筑", "note": ""},
 {"id": 40, "building_id": 4, "year": 0, "date": "（用途）", "fact": "皇帝赴太和殿参加大典前，先在中和殿小憩并接受执事官员朝拜；皇帝亲祭天、地、社稷、太庙、先农坛前一日，在此阅视祝版。", "people": "", "place": "北京", "source": "维基百科（中文）《中和殿》", "source_url": "https://zh.wikipedia.org/wiki/中和殿", "source_locator": "历史", "note": ""},
 {"id": 41, "building_id": 4, "year": 0, "date": "（用途）", "fact": "皇太后上徽号时，皇帝在中和殿阅视拟好的奏书；清朝每七年纂修一次玉牒（皇家家谱），玉牒告成后在中和殿呈御览并举行存放仪式。", "people": "", "place": "北京", "source": "维基百科（中文）《中和殿》", "source_url": "https://zh.wikipedia.org/wiki/中和殿", "source_locator": "历史", "note": ""},
 {"id": 42, "building_id": 4, "year": 0, "date": "（陈设）", "fact": "中和殿内设宝座及两肩舆，宝座上方悬乾隆帝御题「允执厥中」匾。", "people": "乾隆帝", "place": "北京", "source": "维基百科（中文）《中和殿》", "source_url": "https://zh.wikipedia.org/wiki/中和殿", "source_locator": "建筑", "note": ""},

 {"id": 43, "building_id": 5, "year": 1420, "date": "1420（永乐十八年）", "fact": "保和殿建成于永乐十八年（1420年），初名「谨身殿」。", "people": "", "place": "北京", "source": "维基百科（中文）《保和殿》", "source_url": "https://zh.wikipedia.org/wiki/保和殿", "source_locator": "历史", "note": ""},
 {"id": 44, "building_id": 5, "year": 1645, "date": "1562／1645", "fact": "嘉靖年间火灾后重建，嘉靖四十一年（1562年）改称「建极殿」；清顺治二年（1645年）改名「保和殿」，名出自《易经》。", "people": "", "place": "北京", "source": "维基百科（中文）《保和殿》", "source_url": "https://zh.wikipedia.org/wiki/保和殿", "source_locator": "历史", "note": ""},
 {"id": 45, "building_id": 5, "year": 0, "date": "（用途）", "fact": "明代举行大典前皇帝常在此更衣；清代每年除夕、正月十五，皇帝在此赐宴外藩、王公及一二品大臣。", "people": "", "place": "北京", "source": "维基百科（中文）《保和殿》", "source_url": "https://zh.wikipedia.org/wiki/保和殿", "source_locator": "历史", "note": ""},
 {"id": 46, "building_id": 5, "year": 1656, "date": "1646–1656（顺治三年至十三年）", "fact": "后三宫修复前，顺治帝曾居保和殿，时称「位育宫」，其大婚也在此举行。", "people": "顺治帝", "place": "北京", "source": "维基百科（中文）《保和殿》", "source_url": "https://zh.wikipedia.org/wiki/保和殿", "source_locator": "历史", "note": ""},
 {"id": 47, "building_id": 5, "year": 1669, "date": "1661–1669（康熙元年至八年）", "fact": "康熙帝自即位至康熙八年（1669年）居住保和殿，时称「清宁宫」。", "people": "康熙帝", "place": "北京", "source": "维基百科（中文）《保和殿》", "source_url": "https://zh.wikipedia.org/wiki/保和殿", "source_locator": "历史", "note": ""},
 {"id": 48, "building_id": 5, "year": 1789, "date": "1789（乾隆五十四年）", "fact": "自乾隆五十四年（1789年）起，保和殿成为每科殿试的固定场所；题目由皇帝拟定，并指定大臣阅卷。", "people": "乾隆帝", "place": "北京", "source": "维基百科（中文）《保和殿》", "source_url": "https://zh.wikipedia.org/wiki/保和殿", "source_locator": "历史", "note": "英文条目亦记保和殿为殿试最后阶段举行地"},
 {"id": 49, "building_id": 5, "year": 0, "date": "（形制）", "fact": "保和殿面阔九间、进深五间，高29.50米，建筑面积1240平方米，重檐歇山顶，上下檐角安放9个小兽；现存主体梁架仍为明代原构。", "people": "", "place": "北京", "source": "维基百科（中文）《保和殿》", "source_url": "https://zh.wikipedia.org/wiki/保和殿", "source_locator": "建筑", "note": ""},
 {"id": 50, "building_id": 5, "year": 0, "date": "（形制）", "fact": "保和殿后阶陛中间有一块云龙石雕，石料产自京西房山大石窝，拖运时动用一万名以上工人、耗时近一个月。", "people": "", "place": "北京", "source": "维基百科（中文）《保和殿》", "source_url": "https://zh.wikipedia.org/wiki/保和殿", "source_locator": "建筑", "note": "《Forbidden City》条目记为16.57×3.07×1.7米、约200吨，为国内最大石雕"},
 {"id": 51, "building_id": 5, "year": 0, "date": "（制度）", "fact": "清顺治至乾隆年间设「保和殿大学士」一职，为「三殿三阁大学士」之一，鄂尔泰、张廷玉等都曾获此官衔。", "people": "鄂尔泰;张廷玉", "place": "北京", "source": "维基百科（中文）《保和殿》", "source_url": "https://zh.wikipedia.org/wiki/保和殿", "source_locator": "保和殿大学士", "note": ""},

 {"id": 52, "building_id": 6, "year": 1420, "date": "1420（永乐十八年）", "fact": "乾清宫始建于永乐十八年（1420年），是内廷后三宫之一。", "people": "", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史", "note": ""},
 {"id": 53, "building_id": 6, "year": 1440, "date": "1422／1440", "fact": "永乐二十年（1422年）乾清宫毁于火灾，正统五年（1440年）重修竣工。", "people": "", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史", "note": ""},
 {"id": 54, "building_id": 6, "year": 1519, "date": "1514／1519", "fact": "正德九年（1514年）正月十六日晚因放烟火不慎，乾清宫与坤宁宫同时被烧毁，正德十四年（1519年）重建。", "people": "", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史", "note": ""},
 {"id": 55, "building_id": 6, "year": 1598, "date": "1596／1598", "fact": "万历二十四年（1596年）乾清宫与坤宁宫又被烧毁，万历二十六年（1598年）重建竣工。", "people": "", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史", "note": ""},
 {"id": 56, "building_id": 6, "year": 1798, "date": "1797／1798", "fact": "嘉庆二年（1797年）乾清宫发生火灾被烧毁，嘉庆三年（1798年）重建，现存的乾清宫即此次重建后的形制。", "people": "", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史", "note": ""},
 {"id": 57, "building_id": 6, "year": 0, "date": "（用途）", "fact": "明代乾清宫为皇帝寝宫，永乐至崇祯共14位皇帝曾在此居住；清雍正帝移居养心殿后，乾清宫改作召见廷臣、处理政务、批阅奏章、接见外藩、受贺与宴筵之所。", "people": "雍正帝", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史", "note": ""},
 {"id": 58, "building_id": 6, "year": 0, "date": "（陈设）", "fact": "明代悬「敬天法祖」匾，清代改悬顺治帝御书「正大光明」匾（今为乾隆帝临摹本）。", "people": "顺治帝;乾隆帝", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史／建筑", "note": ""},
 {"id": 59, "building_id": 6, "year": 1723, "date": "1723（雍正元年）", "fact": "雍正帝下诏将密建皇储的建储匣存放于乾清宫「正大光明」匾之后，形成秘密立储制度；皇帝亲书继承人名字一式两份，一份随身、一份藏于匣内。", "people": "雍正帝", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史", "note": "英文条目亦载此制度，并称此匾为「正大光明」，意为「让正义显扬」"},
 {"id": 60, "building_id": 6, "year": 1785, "date": "1722／1785", "fact": "清朝皇帝曾在乾清宫举行两次千叟宴：康熙六十一年（1722年）一次，乾隆五十年（1785年）一次；乾隆五十年一次规模最大，有三千多位六十岁以上老人参加。", "people": "康熙帝;乾隆帝", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史", "note": ""},
 {"id": 61, "building_id": 6, "year": 0, "date": "（形制）", "fact": "乾清宫连廊面阔九间、进深五间，建筑面积1400平方米，重檐庑殿顶，自台面至正脊高20余米。", "people": "", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "建筑", "note": ""},
 {"id": 62, "building_id": 6, "year": 0, "date": "（用途）", "fact": "乾清宫也是清代皇帝停灵、暂厝梓宫之处，世祖、圣祖、世宗、高宗、仁宗、宣宗、文宗、穆宗、德宗均停灵于此。", "people": "", "place": "北京", "source": "维基百科（中文）《乾清宫》", "source_url": "https://zh.wikipedia.org/wiki/乾清宫", "source_locator": "历史", "note": ""},

 {"id": 63, "building_id": 7, "year": 0, "date": "（嘉靖以前）", "fact": "交泰殿在明嘉靖年间以前建成，嘉靖以前称「中圆殿」，仿南京「省躬殿」而设。", "people": "", "place": "北京", "source": "维基百科（中文）《交泰殿》", "source_url": "https://zh.wikipedia.org/wiki/交泰殿", "source_locator": "历史", "note": "建成年代原文仅记「嘉靖年间以前」，未直写具体年份"},
 {"id": 64, "building_id": 7, "year": 1655, "date": "1655／1669", "fact": "交泰殿于清顺治十二年（1655年）、康熙八年（1669年）均有重修。", "people": "", "place": "北京", "source": "维基百科（中文）《交泰殿》", "source_url": "https://zh.wikipedia.org/wiki/交泰殿", "source_locator": "历史", "note": ""},
 {"id": 65, "building_id": 7, "year": 1797, "date": "1797（嘉庆二年）", "fact": "嘉庆二年（1797年）乾清宫失火，延烧交泰殿，同年重建。", "people": "", "place": "北京", "source": "维基百科（中文）《交泰殿》", "source_url": "https://zh.wikipedia.org/wiki/交泰殿", "source_locator": "历史", "note": ""},
 {"id": 66, "building_id": 7, "year": 0, "date": "（用途）", "fact": "清代交泰殿是皇后千秋节（生日）受庆贺礼之所，庆典时皇贵妃、贵妃、妃、嫔、公主、福晋、命妇等前来向皇后行礼。", "people": "", "place": "北京", "source": "维基百科（中文）《交泰殿》", "source_url": "https://zh.wikipedia.org/wiki/交泰殿", "source_locator": "历史", "note": ""},
 {"id": 67, "building_id": 7, "year": 1746, "date": "1746（乾隆十一年）", "fact": "乾隆帝将39枚印玺挑选整理，保留其中25枚，称「二十五宝」，存放于交泰殿，为皇帝行使权力的印玺。", "people": "乾隆帝", "place": "北京", "source": "维基百科（中文）《交泰殿》", "source_url": "https://zh.wikipedia.org/wiki/交泰殿", "source_locator": "二十五宝", "note": "英文条目亦记殿内储藏清代25方国玺"},
 {"id": 68, "building_id": 7, "year": 0, "date": "（陈设）", "fact": "清世祖所立「内宫不许干预政事」铁牌曾立于交泰殿。", "people": "顺治帝", "place": "北京", "source": "维基百科（中文）《交泰殿》", "source_url": "https://zh.wikipedia.org/wiki/交泰殿", "source_locator": "历史", "note": "原文称「清世祖」即顺治帝"},
 {"id": 69, "building_id": 7, "year": 0, "date": "（形制）", "fact": "交泰殿平面为正方形，面阔、进深各三间，单檐四角攒尖顶，铜镀金宝顶，黄琉璃瓦；殿内顶部为盘龙藻井，龙口衔宝珠（轩辕镜）。", "people": "", "place": "北京", "source": "维基百科（中文）《交泰殿》", "source_url": "https://zh.wikipedia.org/wiki/交泰殿", "source_locator": "建筑", "note": ""},
 {"id": 70, "building_id": 7, "year": 1798, "date": "1745／1798", "fact": "交泰殿东次间陈设乾隆十年（1745年）制造的铜壶滴漏；西次间陈设嘉庆三年（1798年）造办处制造的大自鸣钟，高5.8米，清代宫内时间以它为准。", "people": "", "place": "北京", "source": "维基百科（中文）《交泰殿》", "source_url": "https://zh.wikipedia.org/wiki/交泰殿", "source_locator": "建筑", "note": ""},

 {"id": 71, "building_id": 8, "year": 1420, "date": "1420（永乐十八年）", "fact": "坤宁宫始建于永乐十八年（1420年）。", "people": "", "place": "北京", "source": "维基百科（中文）《坤宁宫》", "source_url": "https://zh.wikipedia.org/wiki/坤宁宫", "source_locator": "历史", "note": ""},
 {"id": 72, "building_id": 8, "year": 1605, "date": "1514／1596／1605", "fact": "坤宁宫于正德九年（1514年）、万历二十四年（1596年）先后两次毁于火灾，万历三十三年（1605年）重建。", "people": "", "place": "北京", "source": "维基百科（中文）《坤宁宫》", "source_url": "https://zh.wikipedia.org/wiki/坤宁宫", "source_locator": "历史", "note": ""},
 {"id": 73, "building_id": 8, "year": 1655, "date": "1645／1655", "fact": "清顺治元年（1645年）重修；顺治十二年（1655年）仿盛京清宁宫再度重修，成为清宫萨满祭祀的主要场所。", "people": "", "place": "北京", "source": "维基百科（中文）《坤宁宫》", "source_url": "https://zh.wikipedia.org/wiki/坤宁宫", "source_locator": "历史", "note": ""},
 {"id": 74, "building_id": 8, "year": 1798, "date": "1797／1798", "fact": "嘉庆二年（1797年）乾清宫失火延烧坤宁宫前檐，嘉庆三年（1798年）重修。", "people": "", "place": "北京", "source": "维基百科（中文）《坤宁宫》", "source_url": "https://zh.wikipedia.org/wiki/坤宁宫", "source_locator": "历史", "note": ""},
 {"id": 75, "building_id": 8, "year": 1644, "date": "1644", "fact": "坤宁宫在明代是皇后寝宫（中宫）；1644年李自成率军攻入北京时，崇祯帝的皇后（周皇后）在坤宁宫自杀。", "people": "周皇后;崇祯帝;李自成", "place": "北京", "source": "维基百科（中文）《坤宁宫》", "source_url": "https://zh.wikipedia.org/wiki/坤宁宫", "source_locator": "历史", "note": ""},
 {"id": 76, "building_id": 8, "year": 1665, "date": "1665（康熙四年）", "fact": "康熙四年（1665年）康熙帝大婚时，太皇太后指定大婚在坤宁宫行合卺礼；同治帝、光绪帝大婚及溥仪结婚，也均在坤宁宫举行。", "people": "康熙帝;同治帝;光绪帝;溥仪", "place": "北京", "source": "维基百科（中文）《坤宁宫》", "source_url": "https://zh.wikipedia.org/wiki/坤宁宫", "source_locator": "历史", "note": ""},
 {"id": 77, "building_id": 8, "year": 0, "date": "（用途）", "fact": "雍正以后皇帝移住养心殿，皇后也不再居住在坤宁宫；坤宁宫实际成为专供萨满祭祀的场所，日常有朝祭、夕祭，春秋大祭、求福祭、十二月二十三日祭灶等。", "people": "雍正帝", "place": "北京", "source": "维基百科（中文）《坤宁宫》", "source_url": "https://zh.wikipedia.org/wiki/坤宁宫", "source_locator": "历史", "note": "英文条目亦记清廷将其改为萨满祭祀场所"},
 {"id": 78, "building_id": 8, "year": 0, "date": "（形制）", "fact": "坤宁宫坐北朝南，面阔连廊九间、进深三间，黄琉璃瓦重檐庑殿顶；室内东侧两间为暖阁（东暖阁），是皇帝大婚时的洞房。", "people": "", "place": "北京", "source": "维基百科（中文）《坤宁宫》", "source_url": "https://zh.wikipedia.org/wiki/坤宁宫", "source_locator": "建筑", "note": ""},
 {"id": 79, "building_id": 8, "year": 1959, "date": "1959", "fact": "1959年起，坤宁宫布置为原状陈列（宫廷生活原状），延续至今。", "people": "", "place": "北京", "source": "维基百科（中文）《坤宁宫》", "source_url": "https://zh.wikipedia.org/wiki/坤宁宫", "source_locator": "历史", "note": ""},

 {"id": 80, "building_id": 9, "year": 1420, "date": "1420（永乐十八年）", "fact": "神武门建成于永乐十八年（1420年），本称「玄武门」，取中国古代四方神中北方神「玄武」为名。", "people": "", "place": "北京", "source": "维基百科（中文）《神武門》", "source_url": "https://zh.wikipedia.org/wiki/神武門", "source_locator": "历史", "note": ""},
 {"id": 81, "building_id": 9, "year": 0, "date": "（康熙年间）", "fact": "清朝康熙年间，为避康熙帝玄烨（玄）讳，改名「神武门」。", "people": "康熙帝", "place": "北京", "source": "维基百科（中文）《神武門》", "source_url": "https://zh.wikipedia.org/wiki/神武門", "source_locator": "历史", "note": "英文条目亦记因康熙帝名讳而由玄武门改称神武门"},
 {"id": 82, "building_id": 9, "year": 0, "date": "（用途）", "fact": "神武门是紫禁城北门：清代帝后巡幸、去京西各园由此出入；选秀女时被选女子亦由此出入。", "people": "", "place": "北京", "source": "维基百科（中文）《神武門》", "source_url": "https://zh.wikipedia.org/wiki/神武門", "source_locator": "历史", "note": "英文条目记宫女、候选嫔妃亦经此门入宫"},
 {"id": 83, "building_id": 9, "year": 0, "date": "（制度）", "fact": "旧时神武门门楼内设钟、鼓，与北京钟鼓楼相应；每天黄昏鸣钟108响，其后每更鸣钟击鼓，启明时鸣钟报晓；皇帝居住在宫中时不鸣钟。", "people": "", "place": "北京", "source": "维基百科（中文）《神武門》", "source_url": "https://zh.wikipedia.org/wiki/神武門", "source_locator": "历史", "note": ""},
 {"id": 84, "building_id": 9, "year": 0, "date": "（形制）", "fact": "神武门总高31米，平面呈矩形；城台辟门洞3券，城楼面阔5间、进深1间，周围设汉白玉栏杆，重檐庑殿顶，上檐悬蓝底鎏金铜字满汉文合璧「神武门」华带匾。", "people": "", "place": "北京", "source": "维基百科（中文）《神武門》", "source_url": "https://zh.wikipedia.org/wiki/神武門", "source_locator": "建筑", "note": ""},
 {"id": 85, "building_id": 9, "year": 2011, "date": "2011年7月2日", "fact": "故宫参观路线改为「午门进、神武门出」，神武门只作为游客出口。", "people": "", "place": "北京", "source": "维基百科（中文）《神武門》", "source_url": "https://zh.wikipedia.org/wiki/神武門", "source_locator": "首段", "note": ""},

 {"id": 86, "building_id": 10, "year": 1420, "date": "1420（永乐十八年）", "fact": "紫禁城垣四隅之上的角楼建成于明永乐十八年（1420年），清代重修。", "people": "", "place": "北京", "source": "故宫博物院官网「角楼」", "source_url": "https://www.dpm.org.cn/explore/building/236522.html", "source_locator": "首段", "note": ""},
 {"id": 87, "building_id": 10, "year": 0, "date": "（形制）", "fact": "角楼由多个歇山式组成复合式屋顶，覆黄琉璃瓦；主体为方亭式，面阔进深各三间（每面8.73米），四面各加抱厦一间，平面成为中点交叉的十字形。", "people": "", "place": "北京", "source": "故宫博物院官网「角楼」", "source_url": "https://www.dpm.org.cn/explore/building/236522.html", "source_locator": "建筑说明", "note": ""},
 {"id": 88, "building_id": 10, "year": 0, "date": "（形制）", "fact": "角楼由墩台下地面至宝顶高27.50米；上层檐为纵横相交四面显山的歇山顶，正脊交叉处置铜鎏金宝顶。", "people": "", "place": "北京", "source": "故宫博物院官网「角楼」", "source_url": "https://www.dpm.org.cn/explore/building/236522.html", "source_locator": "建筑说明", "note": ""},
 {"id": 89, "building_id": 10, "year": 0, "date": "（功能）", "fact": "角楼是紫禁城城池的一部分，与城垣、城门楼及护城河同属皇宫的防卫设施。", "people": "", "place": "北京", "source": "故宫博物院官网「角楼」", "source_url": "https://www.dpm.org.cn/explore/building/236522.html", "source_locator": "首段", "note": ""},
 {"id": 90, "building_id": 10, "year": 0, "date": "（民间说法）", "fact": "民间以「九梁十八柱七十二条脊」形容角楼结构之复杂；有传说称工匠因卖蝈蝈笼的老者（相传为鲁班）启发而建成。", "people": "鲁班（传说）", "place": "北京", "source": "维基百科（英）《Forbidden City》／故宫博物院官网「角楼」", "source_url": "https://en.wikipedia.org/wiki/Forbidden_City", "source_locator": "Walls and gates", "note": "「72条脊」为民间说法；另有资料称角楼共76条脊。英文条目记鲁班传说"},
 {"id": 91, "building_id": 10, "year": 1594, "date": "1594（万历二十二年）", "fact": "明万历二十二年（1594年）修紫禁城垣，遣官祭神（故宫博物院角楼研究文引《明实录》）。", "people": "", "place": "北京", "source": "故宫博物院《角楼》研究文稿", "source_url": "https://www.dpm.org.cn/Uploads/File/2020/02/19/u5e4d00111f849.pdf", "source_locator": "修缮史", "note": "原文引自《明实录》万历二十二年四月二十六日条"},
 {"id": 92, "building_id": 10, "year": 1644, "date": "1644", "fact": "李自成向陕西撤退前焚毁紫禁城，四周角楼未被焚。", "people": "李自成", "place": "北京", "source": "维基百科（中文）《故宫》", "source_url": "https://zh.wikipedia.org/wiki/故宫", "source_locator": "历史", "note": ""},

 {"id": 93, "building_id": 11, "year": 1420, "date": "明初（永乐帝即位以后）", "fact": "文华殿始建于明朝初年（建成时间估计在永乐帝即位以后），位于外朝协和门以东，与武英殿东西相对。", "people": "明成祖（朱棣）", "place": "北京", "source": "维基百科（中文）《文華殿》", "source_url": "https://zh.wikipedia.org/wiki/文華殿", "source_locator": "历史", "note": "具体建成年代原文仅作推测"},
 {"id": 94, "building_id": 11, "year": 1536, "date": "1536（嘉靖十五年）", "fact": "文华殿因位于东路、东方属木色绿、曾作太子视事之所，屋顶原覆绿琉璃瓦；嘉靖十五年（1536年）改为皇帝便殿后，屋顶改为黄琉璃瓦。", "people": "", "place": "北京", "source": "维基百科（中文）《文華殿》", "source_url": "https://zh.wikipedia.org/wiki/文華殿", "source_locator": "明清时期", "note": ""},
 {"id": 95, "building_id": 11, "year": 1538, "date": "1538（嘉靖十七年）", "fact": "嘉靖十七年（1538年）在文华殿后添建圣济殿。", "people": "", "place": "北京", "source": "维基百科（中文）《文華殿》", "source_url": "https://zh.wikipedia.org/wiki/文華殿", "source_locator": "明清时期", "note": ""},
 {"id": 96, "building_id": 11, "year": 1644, "date": "明末", "fact": "明末李自成攻入紫禁城后，文华殿建筑大多被毁。", "people": "李自成", "place": "北京", "source": "维基百科（中文）《文華殿》", "source_url": "https://zh.wikipedia.org/wiki/文華殿", "source_locator": "明清时期", "note": ""},
 {"id": 97, "building_id": 11, "year": 1683, "date": "1683（康熙二十二年）", "fact": "清康熙二十二年（1683年）开始重建文华殿，因武英殿尚存，故「一切规橅殆依明制为之」，以武英殿为蓝本。", "people": "康熙帝", "place": "北京", "source": "维基百科（中文）《文華殿》", "source_url": "https://zh.wikipedia.org/wiki/文華殿", "source_locator": "明清时期", "note": ""},
 {"id": 98, "building_id": 11, "year": 0, "date": "（用途）", "fact": "清朝重修后，每年春秋仲月在文华殿举办经筵之礼；清朝殿试阅卷工作也在文华殿进行，文华殿大学士为「三殿三阁」之一。", "people": "", "place": "北京", "source": "维基百科（中文）《文華殿》", "source_url": "https://zh.wikipedia.org/wiki/文華殿", "source_locator": "明清时期", "note": ""},
 {"id": 99, "building_id": 11, "year": 1776, "date": "乾隆年间（1776年完工）", "fact": "清乾隆年间在文华殿北面圣济殿遗址上新建文渊阁。", "people": "乾隆帝", "place": "北京", "source": "维基百科（中文）《文華殿》／（英）《Belvedere of Literary Profundity》", "source_url": "https://zh.wikipedia.org/wiki/文華殿", "source_locator": "明清时期", "note": ""},
 {"id": 100, "building_id": 11, "year": 2008, "date": "2008／2018", "fact": "2008年7月15日文华殿对外开放，辟为故宫博物院陶瓷馆；2018年6月专馆改陈，文华殿改为书画馆，陶瓷馆迁至武英殿。", "people": "", "place": "北京", "source": "维基百科（中文）《文華殿》", "source_url": "https://zh.wikipedia.org/wiki/文華殿", "source_locator": "故宫博物院陶瓷馆／书画馆", "note": ""},

 {"id": 101, "building_id": 12, "year": 1420, "date": "明永乐年间", "fact": "武英殿始建于明朝初期永乐年间，与紫禁城其他宫殿同时落成。", "people": "明成祖（朱棣）", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "首段／历史", "note": ""},
 {"id": 102, "building_id": 12, "year": 1644, "date": "1644（崇祯十七年）四月二十九日", "fact": "李自成攻入北京成立大顺政权后，在武英殿举行即位典礼，但次日便撤离北京。", "people": "李自成", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "历史", "note": ""},
 {"id": 103, "building_id": 12, "year": 1644, "date": "1644", "fact": "清军攻入北京后，摄政王多尔衮曾以武英殿作为理事之所；数月后顺治帝入关登基，起初也住在武英殿。", "people": "多尔衮;顺治帝", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "历史", "note": ""},
 {"id": 104, "building_id": 12, "year": 1669, "date": "1669（康熙八年）", "fact": "康熙八年（1669年）太和殿、乾清宫等大殿维修，康熙帝一度住在武英殿。", "people": "康熙帝", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "历史", "note": ""},
 {"id": 105, "building_id": 12, "year": 1680, "date": "1680（康熙十九年）", "fact": "康熙十九年（1680年）设「武英殿造办处」，雍正七年（1729年）更名「武英殿修书处」，掌管刊印、装潢图书之事。", "people": "康熙帝;雍正帝", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "历史", "note": ""},
 {"id": 106, "building_id": 12, "year": 1773, "date": "1773（乾隆三十八年）", "fact": "乾隆三十八年（1773年）命将从《永乐大典》中辑出的138种珍本以木活字排印，御赐名曰《武英殿聚珍版丛书》，世称「殿本」。", "people": "乾隆帝", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "历史", "note": ""},
 {"id": 107, "building_id": 12, "year": 1869, "date": "1869（同治八年）", "fact": "同治八年（1869年）武英殿遭遇火灾，烧毁正殿、后殿、殿门、东配殿、浴德堂等建筑共37间，书籍版片全部焚毁；同年重建。", "people": "", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "历史", "note": ""},
 {"id": 108, "building_id": 12, "year": 1914, "date": "1914年10月10日", "fact": "民国三年（1914年）10月10日，武英殿辟为古物陈列所的陈列室，正式对外开放展览，这是紫禁城首次对公众开放。", "people": "", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "历史", "note": ""},
 {"id": 109, "building_id": 12, "year": 2005, "date": "2002–2005", "fact": "武英殿古建筑修缮工程于2002年至2004年进行、2005年验收，为故宫大修的试点工程；2005年10月起武英殿正式对外开放。", "people": "", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "历史", "note": ""},
 {"id": 110, "building_id": 12, "year": 0, "date": "（形制）", "fact": "武英门面阔五间（30.4米）、进深二间（11.7米）；正殿武英殿面阔五间（33.4米）、进深三间，黄琉璃瓦单檐歇山顶，建筑群坐落于1.5米高台基上。", "people": "", "place": "北京", "source": "维基百科（中文）《武英殿》", "source_url": "https://zh.wikipedia.org/wiki/武英殿", "source_locator": "建筑", "note": ""},

 {"id": 111, "building_id": 13, "year": 1776, "date": "1776（乾隆四十一年）", "fact": "现存文渊阁于清乾隆年间建于文华殿之后，完工于乾隆四十一年（1776年），形制仿宁波天一阁。", "people": "乾隆帝", "place": "北京", "source": "维基百科（英）《Belvedere of Literary Profundity》", "source_url": "https://en.wikipedia.org/wiki/Belvedere_of_Literary_Profundity", "source_locator": "正文", "note": ""},
 {"id": 112, "building_id": 13, "year": 0, "date": "（用途）", "fact": "文渊阁是皇家藏书楼与讲学之所，曾藏《四库全书》一部等大量图书。", "people": "", "place": "北京", "source": "维基百科（英）《Belvedere of Literary Profundity》", "source_url": "https://en.wikipedia.org/wiki/Belvedere_of_Literary_Profundity", "source_locator": "正文", "note": ""},
 {"id": 113, "building_id": 13, "year": 0, "date": "（形制）", "fact": "文渊阁是紫禁城内使用黑色琉璃瓦的特例，因黑属水、主防火；其余宫殿屋顶几乎都用黄色琉璃瓦。", "people": "", "place": "北京", "source": "维基百科（英）《Forbidden City》", "source_url": "https://en.wikipedia.org/wiki/Forbidden_City", "source_locator": "Architecture·Symbolism", "note": ""},
 {"id": 114, "building_id": 13, "year": 0, "date": "（对照建筑）", "fact": "承德避暑山庄的文津阁是文渊阁的对应建筑。", "people": "", "place": "北京／承德", "source": "维基百科（英）《Belvedere of Literary Profundity》", "source_url": "https://en.wikipedia.org/wiki/Belvedere_of_Literary_Profundity", "source_locator": "正文", "note": ""},

 {"id": 115, "building_id": 14, "year": 1537, "date": "1537（明嘉靖十六年）", "fact": "养心殿建于明朝嘉靖年间，建成于嘉靖十六年（1537年）以前，曾作为明神宗（万历帝）寝宫。", "people": "明神宗（万历帝）", "place": "北京", "source": "维基百科（中文）《养心殿》／（英）《Hall of Mental Cultivation》", "source_url": "https://zh.wikipedia.org/wiki/养心殿", "source_locator": "历史", "note": "中文条目记「建成于嘉靖十六年以前」，英文条目记建成于1537年"},
 {"id": 116, "building_id": 14, "year": 1661, "date": "清初", "fact": "清世祖（顺治帝）病逝于养心殿。", "people": "顺治帝", "place": "北京", "source": "维基百科（中文）《养心殿》", "source_url": "https://zh.wikipedia.org/wiki/养心殿", "source_locator": "历史", "note": "原文「清朝初年，清世祖病逝于养心殿」；顺治帝卒于1661年"},
 {"id": 117, "building_id": 14, "year": 0, "date": "（康熙年间）", "fact": "康熙年间养心殿曾作为宫中造办处的作坊，专门制作宫廷御用物品；康熙帝曾在此接见西洋人。", "people": "康熙帝", "place": "北京", "source": "维基百科（中文）《养心殿》／（英）《Hall of Mental Cultivation》", "source_url": "https://zh.wikipedia.org/wiki/养心殿", "source_locator": "历史", "note": ""},
 {"id": 118, "building_id": 14, "year": 1723, "date": "1723（雍正元年）起", "fact": "自雍正帝起，养心殿成为皇帝的寝宫与理政中心；此后共8位皇帝先后居此，直到逊帝溥仪出宫。", "people": "雍正帝;乾隆帝;嘉庆帝;道光帝;咸丰帝;同治帝;光绪帝;溥仪", "place": "北京", "source": "维基百科（中文）《养心殿》", "source_url": "https://zh.wikipedia.org/wiki/养心殿", "source_locator": "历史", "note": ""},
 {"id": 119, "building_id": 14, "year": 0, "date": "（陈设）", "fact": "养心殿内的三希堂藏王羲之《快雪时晴帖》、王献之《中秋帖》、王珣《伯远帖》三件书法，以及乾隆帝所集134件法帖。", "people": "乾隆帝;王羲之;王献之;王珣", "place": "北京", "source": "维基百科（英）《Hall of Mental Cultivation》", "source_url": "https://en.wikipedia.org/wiki/Hall_of_Mental_Cultivation", "source_locator": "Hall of Three Rarities", "note": ""},
 {"id": 120, "building_id": 14, "year": 0, "date": "（史料）", "fact": "咸丰帝死后，慈安、慈禧两宫皇太后在养心殿东暖阁垂帘听政，先后辅佐幼年即位的同治帝、光绪帝。", "people": "慈安太后;慈禧太后;同治帝;光绪帝", "place": "北京", "source": "维基百科（中文）《养心殿》／（英）《Hall of Mental Cultivation》", "source_url": "https://zh.wikipedia.org/wiki/养心殿", "source_locator": "历史", "note": ""},
 {"id": 121, "building_id": 14, "year": 1912, "date": "1912年2月12日", "fact": "《清帝逊位诏书》在养心殿由袁世凯呈给隆裕太后，宣统帝随即下诏逊位。", "people": "宣统帝（溥仪）;隆裕太后;袁世凯", "place": "北京", "source": "维基百科（中文）《养心殿》", "source_url": "https://zh.wikipedia.org/wiki/养心殿", "source_locator": "历史", "note": ""},
 {"id": 122, "building_id": 14, "year": 0, "date": "（形制）", "fact": "养心殿平面呈「工」字形（一说「H」形），占地约3800平方米；正殿为木构、穹顶藻井，周围为军机处等政府机构。", "people": "", "place": "北京", "source": "维基百科（英）《Hall of Mental Cultivation》", "source_url": "https://en.wikipedia.org/wiki/Hall_of_Mental_Cultivation", "source_locator": "Layout", "note": ""},
 {"id": 123, "building_id": 14, "year": 2025, "date": "2015–2025", "fact": "2015年底故宫博物院启动养心殿研究性保护项目并闭馆；2018年9月启动古建筑修缮工程，2025年12月26日修缮后重新开放。", "people": "", "place": "北京", "source": "维基百科（中文）《养心殿》／（英）《Hall of Mental Cultivation》", "source_url": "https://zh.wikipedia.org/wiki/养心殿", "source_locator": "历史", "note": "英文条目记2025年12月重新开放"},

 {"id": 124, "building_id": 15, "year": 1773, "date": "1773（乾隆三十八年）", "fact": "故宫九龙壁位于紫禁城宁寿宫区皇极门前的影壁，建于清乾隆三十八年（1773年）。", "people": "乾隆帝", "place": "北京", "source": "维基百科（中文）《九龙壁》", "source_url": "https://zh.wikipedia.org/wiki/九龙壁", "source_locator": "故宫九龙壁", "note": ""},
 {"id": 125, "building_id": 15, "year": 0, "date": "（分布）", "fact": "中国现存的古代琉璃九龙壁共四处：大同九龙壁、平遥九龙壁、北海九龙壁、故宫九龙壁。", "people": "", "place": "中国", "source": "维基百科（中文）《九龙壁》", "source_url": "https://zh.wikipedia.org/wiki/九龙壁", "source_locator": "首段", "note": ""},
 {"id": 126, "building_id": 15, "year": 0, "date": "（形制）", "fact": "九龙壁是一种装饰有九条大龙的琉璃影壁，多为明清皇家所用；故宫九龙壁为宁寿宫皇极门前的照壁。", "people": "", "place": "北京", "source": "维基百科（中文）《九龙壁》／（英）《Forbidden City》", "source_url": "https://zh.wikipedia.org/wiki/九龙壁", "source_locator": "首段", "note": "英文条目记宁寿宫入口以琉璃九龙壁为标志"},

 {"id": 127, "building_id": 16, "year": 1538, "date": "1536–1538（嘉靖十五年至十七年）", "fact": "明嘉靖十五年（1536年）拆除大善殿，在原地兴建慈宁宫，嘉靖十七年（1538年）建成，为明世宗生母蒋太后的寝宫。", "people": "明世宗（嘉靖帝）;蒋太后", "place": "北京", "source": "维基百科（中文）《慈寧宮》", "source_url": "https://zh.wikipedia.org/wiki/慈寧宮", "source_locator": "明朝", "note": "嘉靖四年（1525年）仁寿宫曾失火焚毁"},
 {"id": 128, "building_id": 16, "year": 1585, "date": "1583／1585", "fact": "万历十一年（1583年）慈宁宫正殿遭火灾，万历十三年（1585年）重建落成。", "people": "", "place": "北京", "source": "维基百科（中文）《慈寧宮》", "source_url": "https://zh.wikipedia.org/wiki/慈寧宮", "source_locator": "明朝", "note": ""},
 {"id": 129, "building_id": 16, "year": 1653, "date": "1653（顺治十年）", "fact": "清顺治十年（1653年）慈宁宫依旧制重建，同年六月二十六日落成；闰六月十二日，皇太后率太宗后妃移居此宫，自此成为专供太皇太后、皇太后居住的宫室。", "people": "昭聖皇太后", "place": "北京", "source": "维基百科（中文）《慈寧宮》", "source_url": "https://zh.wikipedia.org/wiki/慈寧宮", "source_locator": "清朝", "note": ""},
 {"id": 130, "building_id": 16, "year": 1687, "date": "1687（康熙二十六年）", "fact": "昭圣太皇太后（孝莊文皇后）居慈宁宫，康熙二十六年（1687年）病逝于此；因其威望极高，此后清代历位太后多不敢入居。", "people": "孝莊文皇后（昭圣太皇太后）;康熙帝", "place": "北京", "source": "维基百科（中文）《慈寧宮》", "source_url": "https://zh.wikipedia.org/wiki/慈寧宮", "source_locator": "清朝·用途", "note": "孝莊文皇后卒年1688年1月（康熙二十六年十二月），条目记康熙二十六年病逝于慈宁宫"},
 {"id": 131, "building_id": 16, "year": 1771, "date": "1757–1771（乾隆三十二年至三十六年）", "fact": "乾隆三十二年至三十六年（1757–1771年）对慈宁宫进行重建；乾隆三十四年（1769年）将正殿由单檐庑殿顶改建为重檐庑殿顶，并将后寝殿向后移，形成今制。", "people": "乾隆帝", "place": "北京", "source": "维基百科（中文）《慈寧宮》", "source_url": "https://zh.wikipedia.org/wiki/慈寧宮", "source_locator": "清朝", "note": ""},
 {"id": 132, "building_id": 16, "year": 0, "date": "（形制）", "fact": "慈宁宫正殿面阔七间、前后出廊，黄琉璃瓦重檐歇山顶；后殿大佛堂为清朝太后、太妃礼佛之所，是紫禁城内体量最大的佛堂。", "people": "", "place": "北京", "source": "维基百科（中文）《慈寧宮》", "source_url": "https://zh.wikipedia.org/wiki/慈寧宮", "source_locator": "建筑", "note": ""},
 {"id": 133, "building_id": 16, "year": 1973, "date": "1973", "fact": "1973年慈宁宫大佛堂的三世佛、十八罗汉等文物被调拨运往洛阳白马寺。", "people": "", "place": "北京／洛阳", "source": "维基百科（中文）《慈寧宮》", "source_url": "https://zh.wikipedia.org/wiki/慈寧宮", "source_locator": "民国以后", "note": ""},
 {"id": 134, "building_id": 16, "year": 2015, "date": "2015年10月10日", "fact": "2015年10月10日，为庆祝故宫博物院建院90周年，慈宁宫作为故宫博物院雕塑馆对外开放。", "people": "", "place": "北京", "source": "维基百科（中文）《慈寧宮》", "source_url": "https://zh.wikipedia.org/wiki/慈寧宮", "source_locator": "民国以后", "note": "英文条目亦记2015年在慈宁宫开设雕塑馆"},

 {"id": 135, "building_id": 17, "year": 1420, "date": "1420（永乐十八年）", "fact": "储秀宫始建于永乐十八年（1420年），初名「寿昌宫」，为内廷西六宫之一。", "people": "", "place": "北京", "source": "维基百科（中文）《儲秀宮》", "source_url": "https://zh.wikipedia.org/wiki/儲秀宮", "source_locator": "历史", "note": ""},
 {"id": 136, "building_id": 17, "year": 1535, "date": "1535（嘉靖十四年）", "fact": "嘉靖十四年（1535年）「寿昌宫」更名为「储秀宫」。", "people": "", "place": "北京", "source": "维基百科（中文）《儲秀宮》", "source_url": "https://zh.wikipedia.org/wiki/儲秀宮", "source_locator": "历史", "note": ""},
 {"id": 137, "building_id": 17, "year": 1741, "date": "1741（乾隆六年）", "fact": "乾隆六年（1741年）乾隆帝命依照永寿宫陡匾式样制作十一面匾额并亲题，分挂东六宫、西六宫其他十一宫正殿，并下谕「自挂之后，至千万年，不可擅动」。", "people": "乾隆帝", "place": "北京", "source": "维基百科（中文）《儲秀宮》", "source_url": "https://zh.wikipedia.org/wiki/儲秀宮", "source_locator": "历史", "note": ""},
 {"id": 138, "building_id": 17, "year": 0, "date": "（人物）", "fact": "慈禧太后早年入宫后曾居住储秀宫后殿，并在此生下同治帝。", "people": "慈禧太后;同治帝", "place": "北京", "source": "维基百科（中文）《儲秀宮》", "source_url": "https://zh.wikipedia.org/wiki/儲秀宮", "source_locator": "历史", "note": ""},
 {"id": 139, "building_id": 17, "year": 1861, "date": "1861（咸丰十一年）", "fact": "咸丰十一年（1861年）咸丰帝驾崩、同治帝登基后，慈禧与皇后以皇太后身份移居长春宫。", "people": "慈禧太后;同治帝", "place": "北京", "source": "维基百科（中文）《儲秀宮》", "source_url": "https://zh.wikipedia.org/wiki/儲秀宮", "source_locator": "历史", "note": ""},
 {"id": 140, "building_id": 17, "year": 1884, "date": "1884（光绪十年）", "fact": "光绪十年（1884年）为庆祝慈禧太后五十寿辰，花费63万两白银大规模整修储秀宫；现存建筑为光绪十年重修之后的形制。", "people": "慈禧太后", "place": "北京", "source": "维基百科（中文）《儲秀宮》", "source_url": "https://zh.wikipedia.org/wiki/儲秀宮", "source_locator": "历史", "note": ""},
 {"id": 141, "building_id": 17, "year": 0, "date": "（形制）", "fact": "光绪十年后，储秀宫与翊坤宫之间的储秀门及围墙被拆除，改建体和殿，形成前后相通的四进院落；正殿单檐歇山顶，面阔五间、前出廊。", "people": "", "place": "北京", "source": "维基百科（中文）《儲秀宮》", "source_url": "https://zh.wikipedia.org/wiki/儲秀宮", "source_locator": "建筑", "note": ""},
 {"id": 142, "building_id": 17, "year": 1922, "date": "1922（民国十一年）", "fact": "溥仪皇后婉容婚后入住储秀宫，将正殿西暖阁改为浴室、体和殿改为书房、丽景轩改为西餐房。", "people": "婉容;溥仪", "place": "北京", "source": "维基百科（中文）《儲秀宮》", "source_url": "https://zh.wikipedia.org/wiki/儲秀宮", "source_locator": "居住者", "note": ""},
 {"id": 143, "building_id": 17, "year": 1910, "date": "1910（宣统二年二月）", "fact": "宣统二年二月（1910年4月），紫禁城内安装10门用户交换机，在后宫建福宫、储秀宫、长春宫设专线电话共6部，是中国最早的皇家电话局。", "people": "", "place": "北京", "source": "维基百科（中文）《儲秀宮》", "source_url": "https://zh.wikipedia.org/wiki/儲秀宮", "source_locator": "缓福殿", "note": "条目记「每处设专线电话共6部」，各处数目未细分"},

 {"id": 144, "building_id": 18, "year": 1420, "date": "1420（永乐十八年）", "fact": "钦安殿位于御花园正中、紫禁城南北中轴线上，始建于明代永乐年间，与紫禁城同期落成。", "people": "明成祖（朱棣）", "place": "北京", "source": "故宫博物院官网「钦安殿」", "source_url": "https://www.dpm.org.cn/explore/building/236494.html", "source_locator": "首段", "note": "另有官网研究文稿与百科条目明确记为永乐十八年建成"},
 {"id": 145, "building_id": 18, "year": 1535, "date": "1535（嘉靖十四年）", "fact": "嘉靖十四年（1535年）添建墙垣及天一门，钦安殿院落自成格局，成为皇家道观区。", "people": "明世宗（嘉靖帝）", "place": "北京", "source": "故宫博物院官网「钦安殿」／故宫博物院「钦安殿奉道」", "source_url": "https://www.dpm.org.cn/explore/building/236494.html", "source_locator": "首段", "note": ""},
 {"id": 146, "building_id": 18, "year": 0, "date": "（供奉）", "fact": "钦安殿内供奉玄天上帝（真武大帝）铜像，为永乐时期铸造；钦安殿是紫禁城中轴线上唯一供奉神像的宫殿。", "people": "明成祖（朱棣）", "place": "北京", "source": "故宫博物院《钦安殿综述》", "source_url": "https://www.dpm.org.cn/Uploads/File/2020/02/18/u5e4bb67fc7439.pdf", "source_locator": "综述", "note": ""},
 {"id": 147, "building_id": 18, "year": 0, "date": "（缘由）", "fact": "永乐帝自比真武大帝（真武曾「翊助」其靖难），故在宫城北面（北方属水、配玄武）建钦安殿供奉玄天上帝，兼有镇火灾之意。", "people": "明成祖（朱棣）", "place": "北京", "source": "故宫博物院《钦安殿综述》", "source_url": "https://www.dpm.org.cn/Uploads/File/2020/02/18/u5e4bb67fc7439.pdf", "source_locator": "综述", "note": "「翊助靖难」为论文据永乐敕文与碑文的论述"},
 {"id": 148, "building_id": 18, "year": 0, "date": "（用途）", "fact": "清代每年元旦于天一门内设斗坛，皇帝在此拈香行礼；年节时在钦安殿设道场，道官设醮进表；钦安殿事务由太监道士管理。", "people": "", "place": "北京", "source": "故宫博物院官网「钦安殿」", "source_url": "https://www.dpm.org.cn/explore/building/236494.html", "source_locator": "首段", "note": ""},
 {"id": 149, "building_id": 18, "year": 0, "date": "（形制）", "fact": "钦安殿为重檐盝顶，坐落在汉白玉单层须弥座上，面阔五间、进深三间，黄琉璃瓦顶；前出月台，四周绕以穿花龙纹汉白玉栏杆，殿后正中一块栏板为双龙戏水纹。", "people": "", "place": "北京", "source": "故宫博物院官网「钦安殿」", "source_url": "https://www.dpm.org.cn/explore/building/236494.html", "source_locator": "首段", "note": ""},
 {"id": 150, "building_id": 18, "year": 0, "date": "（清乾隆年间）", "fact": "清乾隆年间曾在钦安殿前檐接盖抱厦三间，后拆除。", "people": "乾隆帝", "place": "北京", "source": "故宫博物院官网「钦安殿」", "source_url": "https://www.dpm.org.cn/explore/building/236494.html", "source_locator": "首段", "note": ""}
]
